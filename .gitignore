# Python
__pycache__/
*.pyc
.venv/

# Supplier files we may not redistribute (`fetch-only` and `private`). Only
# their row in vendor-index.csv is committed. The file itself is fetched from
# the brand, or copied from stoq-private with `bash doqs.sh restore-private`.
# `bash doqs.sh check` fails if one of these files is tracked.
# Validation warns rather than fails when one is absent, so CI stays green on a
# fresh clone.
#
# List the exact paths your fetch-only rows name, for example:
#
# modules/thk/modules/shs-rail/cad/parts/SHS20R300.FCStd
# modules/thk/modules/shs-rail/cad/original/SHS20R300.step
modules/agito/modules/agd155/docs/datasheets/agito-agd155-product-manual-rev3.4.pdf
modules/agito/modules/agd156/docs/datasheets/agito-agd156-product-manual-rev1.1.pdf

# FreeCAD rotates a backup beside every document it saves. It is a copy of the
# file next to it, so it never belongs in the history.
*.FCBak
*.FCStd1

# Copley Xenus Plus Compact firmware: fetch-only, our copy is in stoq-private.
modules/copley/firmware/XEC_4.36.cff
modules/copley/firmware/XEC_4.60.cff
modules/copley/firmware/XEC_enet_4.88.cff
modules/copley/firmware/XPC_4.36.cff
modules/copley/firmware/XPC_4.60.cff

# Kollmorgen AKD2G manuals for other safety options: fetch-only, our copy is in stoq-private.
modules/kollmorgen/modules/akd2g/docs/datasheets/kollmorgen-akd2g-s-installation-manual-fs2-revg-en.pdf
modules/kollmorgen/modules/akd2g/docs/datasheets/kollmorgen-akd2g-s-installation-manual-fs3-revg-en.pdf

# Skill links made by .agents/scripts/link_skills.sh at the start of each session.
/.claude/skills/
